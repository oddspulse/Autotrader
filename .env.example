# ====================================
# SOLANA PERPETUALS AUTO-TRADER CONFIG
# ====================================

# Network & RPC
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
SOLANA_NETWORK=mainnet-beta
# For devnet testing: https://api.devnet.solana.com

# Server Configuration (for iPad/remote access)
HOST=0.0.0.0
PORT=3001

# Trading Venue (drift | jupiter)
EXCHANGE=drift

# Market Configuration
# ALLOWED SYMBOLS (hard restriction): BTC,ETH,SOL,HYPE,ZEC
SYMBOLS=BTC,ETH,SOL,HYPE,ZEC
ACTIVE_SYMBOL=SOL

# Position Sizing
ALLOCATION_PCT=0.60
MAX_LEVERAGE=10

# Risk/Reward (Fixed Strategy)
TAKE_PROFIT_PCT=0.20
STOP_LOSS_PCT=0.05

# Signal Configuration
TIMEFRAME=5m
SIGNAL_STRATEGY=ema_crossover
EMA_FAST=9
EMA_SLOW=21

# Risk Guardrails
DAILY_LOSS_CAP_PCT=0.03
MAX_CONSECUTIVE_LOSSES=3
CONSECUTIVE_LOSS_COOLDOWN_HOURS=6
MAX_SLIPPAGE_PCT=0.003

# Order Management
ORDER_TIMEOUT_SECONDS=30
MAX_RETRIES=3

# Trading Mode
PAPER_TRADING=true

# Database
DATABASE_PATH=./data/trades.db

# Server
PORT=3001
FRONTEND_URL=http://localhost:3000

# Logging
LOG_LEVEL=info

# ====================================
# WARNING: LEVERAGED TRADING IS RISKY
# Only trade with funds you can afford to lose.
# This bot executes real trades with real money.
# ====================================
